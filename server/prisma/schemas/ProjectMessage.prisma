model ProjectMessage {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  
  // Optional reference to a document being commented on (feedback / reviews)
  documentId   String?
  document     Document? @relation("DocumentComments", fields: [documentId], references: [id], onDelete: SetNull)

  // Optional attached document (e.g. draft paper uploaded in chat)
  attachmentId String?   @unique
  attachment   Document? @relation("MessageAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  content      String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}
